# Copy this file to .env and point ASTROMORPH at a live backend.
# Leave empty to use the in-browser mock data. Set this to the FastAPI base URL
# when the backend is running, for example http://localhost:8000.
VITE_API_BASE_URL=

# Firebase Web app configuration (Firebase Console > Project settings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=