# Comma-separated list of frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:5173

# Set either GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file
# path, FIREBASE_SERVICE_ACCOUNT_JSON to the JSON contents, or use
# Application Default Credentials in your deployment environment.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
